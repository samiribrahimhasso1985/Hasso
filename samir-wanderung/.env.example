# SSBN — environment configuration example.
# Copy to .env (never commit .env). Server variables stay on the server; only VITE_* reach the browser.

# ---- Server (node server/index.mjs) ----
PORT=8787
# production enables Secure cookies (requires HTTPS)
NODE_ENV=production
# Set to 1 only behind a trusted reverse proxy (uses X-Forwarded-For for rate limits)
TRUST_PROXY=0
# Where the SQLite database and uploaded community media are stored
DATA_DIR=./server/data
# DB_FILE=./server/data/social.db

# Routing / geocoding / weather / trails — defaults are public community services with fair-use limits.
# For production traffic self-host Valhalla & Nominatim or use a commercial provider.
VALHALLA_URL=https://valhalla1.openstreetmap.de
NOMINATIM_URL=https://nominatim.openstreetmap.org
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
OVERPASS_URLS=https://overpass-api.de/api/interpreter
# Identify your deployment to upstream providers (required by the Nominatim/OSMF usage policies)
UPSTREAM_USER_AGENT=SSBN/0.1 (+https://your-domain.example; contact@your-domain.example)

# AI hiking assistant (server-side only — never exposed to the browser)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ---- Frontend (build time, public) ----
# Vector basemap style (OpenFreeMap by default; no key)
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Optional: Cesium ion access token for Cesium World Terrain on the globe.
# This is a public, client-side token — restrict it to your domain in the Cesium ion dashboard.
VITE_CESIUM_ION_TOKEN=
# Optional: API base URL if the server runs on another origin
VITE_API_BASE=
