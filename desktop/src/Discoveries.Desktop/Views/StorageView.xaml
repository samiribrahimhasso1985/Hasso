<UserControl x:Class="Discoveries.Desktop.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{DynamicResource Common.Refresh}" Command="{Binding RefreshCommand}" Style="{StaticResource Btn.Secondary}" />
                <TextBlock Text="{DynamicResource Nav.storage}" Style="{StaticResource T.PageTitle}" />
            </DockPanel>
            <TextBlock Text="{DynamicResource Storage.Note}" Foreground="{StaticResource B.Muted}" Margin="0,0,0,6" />
            <TextBlock Text="{Binding DataRoot}" Foreground="{StaticResource B.LightGold}" Margin="0,0,0,16" />
            <ItemsControl ItemsSource="{Binding Drives}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="16" Foreground="{StaticResource B.Gold}" />
                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource B.Muted}" Margin="0,4,0,8" />
                                <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="8"
                                             Foreground="{StaticResource B.Gold}" Background="{StaticResource B.Panel2}" BorderThickness="0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
