<UserControl x:Class="Discoveries.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="{DynamicResource Nav.settings}" Style="{StaticResource T.PageTitle}" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.UiLanguage}" Style="{StaticResource T.CardLabel}" />
                    <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="NativeName"
                              SelectedItem="{Binding SelectedLanguage}" HorizontalAlignment="Left" MinWidth="220" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.SonySdkFolder}" Style="{StaticResource T.CardLabel}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{DynamicResource Settings.ChooseFolder}" Command="{Binding ChooseSdkFolderCommand}"
                                Style="{StaticResource Btn.Secondary}" Margin="8,4,0,10" />
                        <TextBox Text="{Binding SonySdkFolder, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" />
                    </DockPanel>
                    <TextBlock Text="{DynamicResource Settings.Pace}" Style="{StaticResource T.CardLabel}" />
                    <TextBox Text="{Binding Pace, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" MinWidth="120" />
                    <Button Content="{DynamicResource Settings.Save}" Command="{Binding SaveCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.Engine}" Style="{StaticResource T.CardLabel}" />
                    <TextBlock Text="{Binding EngineMessage}" Margin="0,6,0,10" />
                    <WrapPanel>
                        <Button Content="{DynamicResource Settings.StartEngine}" Command="{Binding StartEngineCommand}" />
                        <Button Content="{DynamicResource Settings.CheckEngine}" Command="{Binding CheckEngineCommand}" Style="{StaticResource Btn.Secondary}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.DataFolder}" Style="{StaticResource T.CardLabel}" />
                    <TextBlock Text="{Binding DataFolder}" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="0,6,0,10" />
                    <WrapPanel>
                        <Button Content="{DynamicResource Settings.OpenFolder}" Command="{Binding OpenDataFolderCommand}" Style="{StaticResource Btn.Secondary}" />
                        <Button Content="{DynamicResource Settings.Backup}" Command="{Binding BackupCommand}" Style="{StaticResource Btn.Secondary}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Message}" Foreground="{StaticResource B.LightGold}" Margin="0,4,0,8" />
            <TextBlock Text="{Binding Version}" Foreground="{StaticResource B.Muted}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
