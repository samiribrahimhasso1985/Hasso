<UserControl x:Class="Discoveries.Desktop.Views.EpisodeManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" MinWidth="240" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="3" Text="{DynamicResource Nav.episodes}" Style="{StaticResource T.PageTitle}" />

        <!-- List -->
        <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
            <StackPanel DockPanel.Dock="Top">
                <Button Content="{DynamicResource Ep.New}" Command="{Binding NewEpisodeCommand}" HorizontalAlignment="Stretch" />
                <TextBlock Text="{DynamicResource Common.Search}" Style="{StaticResource T.CardLabel}" />
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource T.CardLabel}" VerticalAlignment="Center" />
                    <CheckBox Content="{DynamicResource Ep.ShowArchived}" IsChecked="{Binding ShowArchived}" />
                </DockPanel>
            </StackPanel>
            <ListBox ItemsSource="{Binding Episodes}" SelectedItem="{Binding SelectedRow}"
                     ItemContainerStyle="{StaticResource RowItem}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="{StaticResource B.Muted}" FontSize="12" />
                                <TextBlock Text="{Binding Header}" Foreground="{StaticResource B.Gold}" FontSize="12" />
                            </DockPanel>
                            <TextBlock Text="{Binding Title}" FontSize="15" Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

        <!-- Hint when nothing is selected -->
        <TextBlock Grid.Row="1" Grid.Column="2" Margin="16,0,0,0" Text="{DynamicResource Ep.SelectHint}"
                   Foreground="{StaticResource B.Muted}" FontSize="16"
                   Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisInv}}" />

        <!-- Editor -->
        <ScrollViewer Grid.Row="1" Grid.Column="2" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <WrapPanel>
                    <Button Content="{DynamicResource Ep.Save}" Command="{Binding SaveCommand}" />
                    <Button Content="{DynamicResource Ep.Analyze}" Command="{Binding AnalyzeCommand}" Style="{StaticResource Btn.Secondary}" />
                    <Button Content="{DynamicResource Ep.Duplicate}" Command="{Binding DuplicateCommand}" Style="{StaticResource Btn.Secondary}" />
                    <Button Content="{DynamicResource Ep.OpenFolder}" Command="{Binding OpenFolderCommand}" Style="{StaticResource Btn.Secondary}" />
                    <Button Content="{DynamicResource Ep.Archive}" Command="{Binding ArchiveCommand}" Style="{StaticResource Btn.Secondary}"
                            Visibility="{Binding SelectedIsArchived, Converter={StaticResource BoolToVisInv}}" />
                    <Button Content="{DynamicResource Ep.Restore}" Command="{Binding RestoreCommand}"
                            Visibility="{Binding SelectedIsArchived, Converter={StaticResource BoolToVis}}" />
                    <Button Content="{DynamicResource Ep.DeleteRecord}" Command="{Binding DeleteRecordCommand}" Style="{StaticResource Btn.Secondary}" />
                </WrapPanel>

                <TextBlock Text="{DynamicResource Ep.FieldTitle}" Style="{StaticResource T.CardLabel}" />
                <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" FontSize="16" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Ep.ContentLanguage}" Style="{StaticResource T.CardLabel}" />
                        <ComboBox ItemsSource="{Binding ContentLanguages}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding EditLanguage}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource Ep.Status}" Style="{StaticResource T.CardLabel}" />
                        <ComboBox ItemsSource="{Binding Statuses}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding EditStatus}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="{DynamicResource Ep.Duration}" Style="{StaticResource T.CardLabel}" />
                        <TextBox Text="{Binding EditDurationMinutes, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{DynamicResource Ep.Description}" Style="{StaticResource T.CardLabel}" />
                <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="60" />

                <TextBlock Text="{DynamicResource Ep.Script}" Style="{StaticResource T.CardLabel}" />
                <TextBox Text="{Binding EditScript, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="Wrap" MinHeight="220" MaxHeight="420" VerticalScrollBarVisibility="Auto"
                         FontSize="16" />

                <TextBlock Text="{Binding Breakdown}" Foreground="{StaticResource B.Gold}" FontWeight="SemiBold" Margin="0,4,0,8"
                           Visibility="{Binding Breakdown, Converter={StaticResource EmptyToCollapsed}}" />
                <ItemsControl ItemsSource="{Binding Scenes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource B.Panel}" CornerRadius="6" Padding="12,8" Margin="0,0,0,6"
                                    BorderBrush="{StaticResource B.Border}" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Foreground="{StaticResource B.Muted}" />
                                        <TextBlock Text="{Binding Header}" Foreground="{StaticResource B.Gold}" FontWeight="SemiBold" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Text}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding Message}" Foreground="{StaticResource B.LightGold}" Margin="0,10,0,0" />
    </Grid>
</UserControl>
