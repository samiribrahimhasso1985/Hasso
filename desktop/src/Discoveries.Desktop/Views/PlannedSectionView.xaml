<UserControl x:Class="Discoveries.Desktop.Views.PlannedSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Title}" Style="{StaticResource T.PageTitle}" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{Binding Header}" FontSize="18" Foreground="{StaticResource B.Gold}" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Planned.Body}" Foreground="{StaticResource B.Muted}" Margin="0,10,0,6" />
                <TextBlock Text="{Binding Requirement}" FontSize="15" Foreground="{StaticResource B.LightGold}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
