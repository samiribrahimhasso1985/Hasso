<Application x:Class="Discoveries.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Discoveries.Desktop.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Cinematic.xaml" />
                <!-- The active language dictionary is added at runtime by LocalizationService. -->
            </ResourceDictionary.MergedDictionaries>
            <v:BoolToVisibilityConverter x:Key="BoolToVis" />
            <v:BoolToVisibilityConverter x:Key="BoolToVisInv" Invert="True" />
            <v:StatusToBrushConverter x:Key="StatusToBrush" />
            <v:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
