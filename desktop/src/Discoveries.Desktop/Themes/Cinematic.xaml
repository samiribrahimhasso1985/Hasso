<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DISCOVERIES design system -->
    <Color x:Key="C.Background">#101010</Color>
    <Color x:Key="C.Panel">#191919</Color>
    <Color x:Key="C.Panel2">#222222</Color>
    <Color x:Key="C.Gold">#C9A34F</Color>
    <Color x:Key="C.LightGold">#E8DCC6</Color>
    <Color x:Key="C.Text">#F5EFE3</Color>
    <Color x:Key="C.Muted">#A9A39A</Color>

    <SolidColorBrush x:Key="B.Background" Color="{StaticResource C.Background}" />
    <SolidColorBrush x:Key="B.Panel" Color="{StaticResource C.Panel}" />
    <SolidColorBrush x:Key="B.Panel2" Color="{StaticResource C.Panel2}" />
    <SolidColorBrush x:Key="B.Gold" Color="{StaticResource C.Gold}" />
    <SolidColorBrush x:Key="B.LightGold" Color="{StaticResource C.LightGold}" />
    <SolidColorBrush x:Key="B.Text" Color="{StaticResource C.Text}" />
    <SolidColorBrush x:Key="B.Muted" Color="{StaticResource C.Muted}" />
    <SolidColorBrush x:Key="B.Border" Color="#2E2E2E" />
    <SolidColorBrush x:Key="B.GoldDim" Color="#33C9A34F" />
    <SolidColorBrush x:Key="B.Ok" Color="#7FB77E" />
    <SolidColorBrush x:Key="B.Warn" Color="#D9A441" />
    <SolidColorBrush x:Key="B.Bad" Color="#D46A5F" />

    <FontFamily x:Key="F.Main">Segoe UI</FontFamily>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Main}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="T.PageTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource B.Gold}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="T.CardLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource B.Muted}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="T.CardValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource B.LightGold}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource B.Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,12,12" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource B.Background}" />
        <Setter Property="Background" Value="{StaticResource B.Gold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource B.LightGold}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn.Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource B.LightGold}" />
        <Setter Property="Background" Value="{StaticResource B.Panel2}" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource B.Panel2}" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource B.Gold}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}" />
        <Setter Property="SelectionBrush" Value="{StaticResource B.Gold}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,4,0,10" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="Margin" Value="0,4,12,8" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Margin" Value="0,4,0,10" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="MinWidth" Value="140" />
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Sidebar items -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Padding="14,8" Margin="6,1" CornerRadius="6" Background="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Panel2}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource B.GoldDim}" />
                            <Setter Property="Foreground" Value="{StaticResource B.Gold}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Generic list rows -->
    <Style x:Key="RowItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Padding="10,8" Margin="0,1" CornerRadius="5" Background="{StaticResource B.Panel2}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Gold}" />
                            <Setter TargetName="bd" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource B.GoldDim}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{StaticResource B.Border}" />
    </Style>
</ResourceDictionary>
