{
  "name": "ezidinet-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "EZIDINET Desktop — runs the complete EZIDINET platform (database, API, web app) locally on one computer. Development/test build.",
  "author": "EZIDINET",
  "main": "src/main.mjs",
  "scripts": {
    "bundle": "node scripts/build-bundle.mjs",
    "start": "electron .",
    "test:runtime": "node scripts/test-runtime.mjs",
    "dist:win": "npm run bundle && electron-builder --publish never --win --x64",
    "dist:linux": "npm run bundle && electron-builder --publish never --linux --x64",
    "test:electron": "node scripts/test-electron.mjs .test-electron"
  },
  "dependencies": {
    "embedded-postgres": "17.11.0-beta.19",
    "@embedded-postgres/windows-x64": "17.11.0-beta.19",
    "@embedded-postgres/linux-x64": "17.11.0-beta.19",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "electron": "39.8.10",
    "electron-builder": "26.0.20",
    "esbuild": "0.25.9"
  },
  "build": {
    "appId": "net.ezidinet.desktop.dev",
    "productName": "EZIDINET",
    "copyright": "EZIDINET — development build",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": false,
    "npmRebuild": false,
    "files": [
      "src/**",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "bundle",
        "to": "bundle"
      }
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "files": [
        "!node_modules/@embedded-postgres/linux-x64/**"
      ]
    },
    "portable": {
      "artifactName": "EZIDINET-Desktop-${version}-portable.exe"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Network",
      "files": [
        "!node_modules/@embedded-postgres/windows-x64/**"
      ]
    },
    "publish": null
  }
}
