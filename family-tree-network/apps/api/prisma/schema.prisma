// FAMILY TREE NETWORK — database schema (Phase 1–2 subset).
// Full target model: docs/DATABASE_SCHEMA.md. Every change goes through a migration.
//
// Core rule: relationships are stored independently of community membership.
// A profile (person) exists once; it may be claimed by one user account or managed by stewards.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  UNSPECIFIED
}

enum Visibility {
  PUBLIC
  NETWORK
  FAMILY
  PRIVATE
}

enum RelationshipCategory {
  FAMILY
  UNION
  FRIENDSHIP
  PROFESSIONAL
  SOCIAL
  CUSTOM
}

enum Directionality {
  SYMMETRIC
  DIRECTED
}

enum VerificationStatus {
  PENDING
  CONFIRMED
  REJECTED
  DISPUTED
}

enum Decision {
  CONFIRM
  REJECT
  DISPUTE
}

enum Side {
  A
  B
}

enum ParentSubtype {
  BIOLOGICAL
  ADOPTIVE
  STEP
  FOSTER
  GUARDIAN
}

enum SiblingSubtype {
  FULL
  HALF
  STEP
  ADOPTIVE
  UNSPECIFIED
}

enum LineageSide {
  PATERNAL
  MATERNAL
  UNSPECIFIED
}

enum UnionEndReason {
  DIVORCE
  DEATH
  SEPARATION
  ANNULMENT
}

enum StewardRole {
  GUARDIAN // parent/guardian of a minor
  CURATOR // relative curating a deceased or offline person's profile
}

enum ProfileField {
  BIRTH_DATE
  COUNTRY
  CITY
  BIO
  LANGUAGES
  INTERESTS
  SKILLS
}

enum CommunityKind {
  FAMILY
  FAMILY_BRANCH
  FRIEND_GROUP
  WORK
  OTHER
}

enum CommunityVisibility {
  PUBLIC
  PRIVATE
}

enum JoinPolicy {
  OPEN
  APPROVAL
  INVITE_ONLY
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  PENDING
}

/// Login identity. One account per person.
model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique // stored lower-cased
  passwordHash String    @map("password_hash")
  locale       String    @default("en") @db.VarChar(5)
  /// Set when the person opened the verification link sent to this address.
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  profile        Profile?          @relation("ProfileOwner")
  stewardships   ProfileSteward[]
  createdRels    Relationship[]    @relation("RelationshipCreator")
  decisions      RelationshipVerification[]
  blocks         Block[]
  auditLogs      AuditLog[]
  createdProfiles Profile[]        @relation("ProfileCreator")
  consents       Consent[]
  authTokens     AuthToken[]
  sessions       Session[]

  @@map("users")
}

/// A person node of the graph. Exactly one per human being.
model Profile {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String?   @unique @map("user_id") @db.Uuid
  displayName String    @map("display_name") @db.VarChar(80)
  fullName    String?   @map("full_name") @db.VarChar(160)
  gender      Gender    @default(UNSPECIFIED)
  birthDate   DateTime? @map("birth_date") @db.Date
  deathDate   DateTime? @map("death_date") @db.Date
  isMinor     Boolean   @default(false) @map("is_minor")
  country     String?   @db.VarChar(2) // ISO 3166-1 alpha-2
  city        String?   @db.VarChar(80)
  bio         String?   @db.VarChar(1000)
  languages   String[]  @default([])
  /// Declared by the member for discovery (lower-case tags); never inferred.
  interests   String[]  @default([])
  skills      String[]  @default([])
  avatarUrl   String?   @map("avatar_url")
  /// Discoverable in people search. Off by default (EZIDNET decision EZ-5); minors never.
  searchable  Boolean   @default(false)
  /// The person accepts connection requests via QR code.
  qrEnabled   Boolean   @default(true) @map("qr_enabled")
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user        User?             @relation("ProfileOwner", fields: [userId], references: [id], onDelete: SetNull)
  createdBy   User?             @relation("ProfileCreator", fields: [createdById], references: [id], onDelete: SetNull)
  stewards    ProfileSteward[]
  privacy     PrivacySetting[]
  outgoing    Relationship[]    @relation("RelFrom")
  incoming    Relationship[]    @relation("RelTo")
  memberships CommunityMembership[]
  blockedBy   Block[]
  identifier  UserIdentifier?
  photo       ProfilePhoto?
  qrTokens    QrToken[]
  qrScans     QrScanEvent[]
  following   Follow[]          @relation("Following")
  followers   Follow[]          @relation("Followers")
  connectSettings ConnectSettings?
  presence    UserPresence?
  notifications        Notification[] @relation("NotificationsReceived")
  causedNotifications  Notification[] @relation("NotificationsCaused")
  notificationPrefs    NotificationPreferences?
  eventsOrganized      Event[]         @relation("EventsOrganized")
  eventRegistrations   EventAttendee[] @relation("EventRegistrations")
  eventSaves           EventSave[]     @relation("EventSaves")

  @@index([displayName])
  @@map("profiles")
}

/// Users who manage an unclaimed profile (child, deceased ancestor).
model ProfileSteward {
  profileId String      @map("profile_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  role      StewardRole
  createdAt DateTime    @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([profileId, userId])
  @@index([userId])
  @@map("profile_stewards")
}

/// Per-field visibility of profile data. Missing row = field default (see docs).
model PrivacySetting {
  profileId  String       @map("profile_id") @db.Uuid
  field      ProfileField
  visibility Visibility
  updatedAt  DateTime     @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, field])
  @@map("privacy_settings")
}

/// Runtime catalog of relationship types (seeded from the engine catalog).
model RelationshipType {
  key               String               @id @db.VarChar(40)
  category          RelationshipCategory
  directionality    Directionality
  sensitive         Boolean
  isUnion           Boolean              @default(false) @map("is_union")
  kinshipUp         Int?                 @map("kinship_up")
  kinshipDown       Int?                 @map("kinship_down")
  defaultVisibility Visibility           @map("default_visibility")
  labels            Json
  inverseLabels     Json                 @map("inverse_labels")
  enabled           Boolean              @default(true)
  sortOrder         Int                  @map("sort_order")

  relationships Relationship[]

  @@map("relationship_types")
}

/// An edge between two profiles, in canonical direction (see RELATIONSHIP_ENGINE.md).
model Relationship {
  id             String               @id @default(uuid()) @db.Uuid
  typeKey        String               @map("type_key") @db.VarChar(40)
  fromProfileId  String               @map("from_profile_id") @db.Uuid
  toProfileId    String               @map("to_profile_id") @db.Uuid
  status         VerificationStatus   @default(PENDING)
  visibility     Visibility
  createdById    String               @map("created_by_id") @db.Uuid
  parentSubtype  ParentSubtype?       @map("parent_subtype")
  siblingSubtype SiblingSubtype?      @map("sibling_subtype")
  lineageSide    LineageSide?         @map("lineage_side")
  startDate      DateTime?            @map("start_date") @db.Date
  endDate        DateTime?            @map("end_date") @db.Date
  endReason      UnionEndReason?      @map("end_reason")
  customLabel    String?              @map("custom_label") @db.VarChar(60)
  customCategory RelationshipCategory? @map("custom_category")
  note           String?              @db.VarChar(500)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  type          RelationshipType           @relation(fields: [typeKey], references: [key])
  fromProfile   Profile                    @relation("RelFrom", fields: [fromProfileId], references: [id], onDelete: Cascade)
  toProfile     Profile                    @relation("RelTo", fields: [toProfileId], references: [id], onDelete: Cascade)
  createdBy     User                       @relation("RelationshipCreator", fields: [createdById], references: [id])
  verifications RelationshipVerification[]

  @@index([fromProfileId, status])
  @@index([toProfileId, status])
  @@index([typeKey])
  @@map("relationships")
}

/// Append-only decision log. The relationship status is computed from it by the engine.
model RelationshipVerification {
  id             String   @id @default(uuid()) @db.Uuid
  relationshipId String   @map("relationship_id") @db.Uuid
  side           Side
  userId         String   @map("user_id") @db.Uuid
  decision       Decision
  comment        String?  @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at")

  relationship Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([relationshipId, createdAt])
  @@index([userId])
  @@map("relationship_verifications")
}

/// Communities (families, branches, friend groups, workplaces).
/// Membership never creates or implies a relationship.
model Community {
  id          String              @id @default(uuid()) @db.Uuid
  kind        CommunityKind
  name        String              @db.VarChar(120)
  description String?             @db.VarChar(2000)
  coverUrl    String?             @map("cover_url")
  visibility  CommunityVisibility @default(PRIVATE)
  joinPolicy  JoinPolicy          @default(APPROVAL) @map("join_policy")
  createdById String              @map("created_by_id") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at")

  memberships CommunityMembership[]

  @@map("communities")
}

model CommunityMembership {
  communityId String           @map("community_id") @db.Uuid
  profileId   String           @map("profile_id") @db.Uuid
  role        MembershipRole   @default(MEMBER)
  status      MembershipStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now()) @map("joined_at")

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([communityId, profileId])
  @@index([profileId])
  @@map("community_memberships")
}

/// A user blocks a person. Visibility rules hide content in both directions.
model Block {
  blockerUserId    String   @map("blocker_user_id") @db.Uuid
  blockedProfileId String   @map("blocked_profile_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  blocker User    @relation(fields: [blockerUserId], references: [id], onDelete: Cascade)
  blocked Profile @relation(fields: [blockedProfileId], references: [id], onDelete: Cascade)

  @@id([blockerUserId, blockedProfileId])
  @@index([blockedProfileId])
  @@map("blocks")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(60)
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   String   @map("entity_id") @db.VarChar(64)
  data       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

enum QrTokenKind {
  PERSONAL // long-lived, revocable, one active per person
  TEMPORARY // short-lived (e.g. for an event)
}

enum QrScanOutcome {
  OK
  SELF
  INVALID
  EXPIRED
  REVOKED
  DISABLED
  BLOCKED
}

/// Public, stable identifiers of an account holder (EZID ID). Never contains personal data.
model UserIdentifier {
  profileId String   @id @map("profile_id") @db.Uuid
  ezidId    String   @unique @map("ezid_id") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("user_identifiers")
}

/// QR connection tokens. Lookup by SHA-256 hash; the token itself is kept only encrypted (AES-256-GCM)
/// so the owner can display the same QR again.
model QrToken {
  id             String      @id @default(uuid()) @db.Uuid
  profileId      String      @map("profile_id") @db.Uuid
  kind           QrTokenKind
  tokenHash      String      @unique @map("token_hash") @db.Char(64)
  tokenEncrypted String      @map("token_encrypted")
  expiresAt      DateTime?   @map("expires_at")
  revokedAt      DateTime?   @map("revoked_at")
  lastUsedAt     DateTime?   @map("last_used_at")
  createdAt      DateTime    @default(now()) @map("created_at")

  profile Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  scans   QrScanEvent[]

  @@index([profileId])
  @@map("qr_tokens")
}

/// Every QR resolution attempt (abuse detection, audit). No IP addresses stored.
model QrScanEvent {
  id               BigInt        @id @default(autoincrement())
  tokenId          String?       @map("token_id") @db.Uuid
  scannerProfileId String        @map("scanner_profile_id") @db.Uuid
  outcome          QrScanOutcome
  createdAt        DateTime      @default(now()) @map("created_at")

  token   QrToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  scanner Profile  @relation(fields: [scannerProfileId], references: [id], onDelete: Cascade)

  @@index([scannerProfileId, createdAt])
  @@map("qr_scan_events")
}

// ---------------------------------------------------------------------------------------------------------------
// Registration & login (complete flow): consents, single-use tokens, server-side sessions, login throttling.

enum ConsentKind {
  TERMS_PRIVACY   // accepted terms of use and privacy policy
  SENSITIVE_DATA  // explicit consent (GDPR Art. 9): membership may reveal religious/ethnic affiliation
  AGE_MINIMUM     // confirmed the minimum age for an own account
}

/// Append-only record of what the person agreed to, when, and to which text version.
model Consent {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  kind        ConsentKind
  version     String      @db.VarChar(40)
  grantedAt   DateTime    @default(now()) @map("granted_at")
  withdrawnAt DateTime?   @map("withdrawn_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@map("consents")
}

enum AuthTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// Single-use tokens sent by email. Only the SHA-256 hash is stored.
model AuthToken {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   AuthTokenPurpose
  tokenHash String           @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime         @map("expires_at")
  usedAt    DateTime?        @map("used_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

/// Server-side session behind every access token, so logout and "log out everywhere" really end access.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  userAgent  String?   @map("user_agent") @db.VarChar(200)
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Failed sign-in counter per e-mail address (hashed), kept whether or not an account exists,
/// so a lock never reveals which addresses are registered.
model LoginThrottle {
  emailHash   String    @id @map("email_hash") @db.Char(64)
  failures    Int       @default(0)
  lockedUntil DateTime? @map("locked_until")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("login_throttles")
}

/// Profile photo (EZIDINET test phase): kept in its own table so it can move to object storage later (spec §29)
/// without touching profiles. Metadata (EXIF/GPS, text chunks) is removed before storing.
model ProfilePhoto {
  profileId String   @id @map("profile_id") @db.Uuid
  mime      String   @db.VarChar(20)
  data      Bytes
  bytes     Int
  version   Int      @default(1)
  /// Who may see the photo. Default: the person's connections. Minors: never beyond family.
  visibility Visibility @default(NETWORK)
  updatedAt DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("profile_photos")
}

// ───────────── EZIDINET CONNECT — Phase 1 (docs/EZIDINET_CONNECT_PLAN.md) ─────────────
// Friendships are FRIENDSHIP relationships (no second friendship table). These tables add following,
// presence and the CONNECT privacy choices of a member's own profile.

enum ConnectAudience {
  EVERYONE
  FRIENDS_OF_FRIENDS
  FRIENDS
  NOBODY
  ONLY_ME
}

enum PresenceMode {
  ONLINE
  BUSY
  AWAY
  INVISIBLE
}

/// One-way following between two member profiles (no approval).
model Follow {
  followerProfileId String   @map("follower_profile_id") @db.Uuid
  followeeProfileId String   @map("followee_profile_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  follower Profile @relation("Following", fields: [followerProfileId], references: [id], onDelete: Cascade)
  followee Profile @relation("Followers", fields: [followeeProfileId], references: [id], onDelete: Cascade)

  @@id([followerProfileId, followeeProfileId])
  @@index([followeeProfileId, createdAt])
  @@map("follows")
}

/// CONNECT privacy choices of a member (missing row = defaults, see ConnectService.DEFAULTS).
model ConnectSettings {
  profileId           String          @id @map("profile_id") @db.Uuid
  friendRequestsFrom  ConnectAudience @default(EVERYONE) @map("friend_requests_from")
  followsFrom         ConnectAudience @default(EVERYONE) @map("follows_from")
  presenceVisibleTo   ConnectAudience @default(FRIENDS) @map("presence_visible_to")
  showLastSeen        Boolean         @default(true) @map("show_last_seen")
  friendListVisibleTo ConnectAudience @default(FRIENDS) @map("friend_list_visible_to")
  statusMode          PresenceMode    @default(ONLINE) @map("status_mode")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("connect_settings")
}

/// Last activity of a member (online = active within the last 2 minutes).
model UserPresence {
  profileId    String   @id @map("profile_id") @db.Uuid
  lastActiveAt DateTime @map("last_active_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("user_presence")
}

// ───────────── EZIDINET CONNECT — unified Notification Service (master integration, phase 2) ─────────────
// One notification table for every CONNECT module. History is kept; a muted category creates nothing;
// quiet hours / do-not-disturb mark a notification as silent (no alert, still in the history).

enum NotificationCategory {
  RELATIONSHIPS
  FRIENDS
  FOLLOWS
  MESSAGES
  CALLS
  GROUPS
  EVENTS
  INVITATIONS
  LEARNING
  CREATORS
  COLLABORATION
  COMMUNITY
  SAFETY
}

model Notification {
  id                 String               @id @default(uuid()) @db.Uuid
  recipientProfileId String               @map("recipient_profile_id") @db.Uuid
  actorProfileId     String?              @map("actor_profile_id") @db.Uuid
  category           NotificationCategory
  type               String               @db.VarChar(40)
  entityType         String?              @map("entity_type") @db.VarChar(40)
  entityId           String?              @map("entity_id") @db.VarChar(64)
  data               Json?
  /// Same key = same event: repeated events update one notification instead of piling up.
  dedupeKey          String?              @map("dedupe_key") @db.VarChar(120)
  silent             Boolean              @default(false)
  readAt             DateTime?            @map("read_at")
  createdAt          DateTime             @default(now()) @map("created_at")

  recipient Profile  @relation("NotificationsReceived", fields: [recipientProfileId], references: [id], onDelete: Cascade)
  actor     Profile? @relation("NotificationsCaused", fields: [actorProfileId], references: [id], onDelete: SetNull)

  @@unique([recipientProfileId, dedupeKey])
  @@index([recipientProfileId, createdAt])
  @@index([recipientProfileId, readAt])
  @@map("notifications")
}

/// Per-member notification choices (missing row = everything on, no quiet hours).
model NotificationPreferences {
  profileId       String                 @id @map("profile_id") @db.Uuid
  mutedCategories NotificationCategory[] @default([]) @map("muted_categories")
  pushEnabled     Boolean                @default(false) @map("push_enabled")
  /// Quiet hours as minutes after midnight in `timeZone` (start may be after end: overnight).
  quietStart      Int?                   @map("quiet_start") @db.SmallInt
  quietEnd        Int?                   @map("quiet_end") @db.SmallInt
  timeZone        String                 @default("UTC") @map("time_zone") @db.VarChar(40)
  dndUntil        DateTime?              @map("dnd_until")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ───────────── EZIDINET Events & ÊZÎDÎ Calendar (docs/events/EVENTS_AUDIT_AND_PLAN.md) ─────────────
// Two kinds of records, linked but never mixed:
//  * calendar_days / calendar_dates — Yazidi holy days, fasts, pilgrimages, remembrance (a date per year,
//    verified by a calendar editor; shown the day before and on the day only).
//  * events — community events published by members (their own dates and lifetime; may celebrate a calendar day).

enum CalendarCategory {
  RELIGIOUS_HOLIDAY
  FASTING
  CULTURAL
  PILGRIMAGE
  HERITAGE
  REMEMBRANCE
  COMMUNITY
  LOCAL_TRADITION
}

enum DateVerification {
  UNVERIFIED
  VERIFIED
  DISPUTED
}

enum EventCategory {
  CULTURAL_FESTIVAL
  RELIGIOUS_CELEBRATION
  COMMUNITY_GATHERING
  HERITAGE_EXHIBITION
  MUSIC
  EDUCATIONAL
  YOUTH
  CHARITY
  MEMORIAL
  ONLINE
  INTERNATIONAL_MEETUP
}

enum EventTemplate {
  RELIGIOUS
  CULTURAL
  HERITAGE
  COMMUNITY
  MEMORIAL
  MUSIC
  INTERNATIONAL
  ONLINE
  LOCAL
}

enum EventAudience {
  PUBLIC
  FRIENDS
  PRIVATE
}

enum EventStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  CANCELLED
  REJECTED
}

enum RegistrationMode {
  NONE
  RSVP
  EXTERNAL
}

enum SessionStatus {
  SCHEDULED
  LIVE
  DONE
  CANCELLED
}

/// A day of the Yazidi calendar (definition; dates per year in calendar_dates).
model CalendarDay {
  id          String           @id @default(uuid()) @db.Uuid
  slug        String           @unique @db.VarChar(60)
  category    CalendarCategory
  /// { ku, ar, de, en } — ku is the original name.
  names       Json
  summary     Json?
  description Json?
  region      String?          @db.VarChar(120)
  tradition   String?          @db.VarChar(200)
  sources     String[]         @default([])
  template    EventTemplate
  /// Shown to members only after a calendar editor reviewed the text.
  published   Boolean          @default(false)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  dates  CalendarDate[]
  events Event[]

  @@map("calendar_days")
}

/// The Gregorian date(s) of a calendar day in one year. Only VERIFIED dates are shown.
model CalendarDate {
  id              String           @id @default(uuid()) @db.Uuid
  dayId           String           @map("day_id") @db.Uuid
  startDate       DateTime         @map("start_date") @db.Date
  endDate         DateTime         @map("end_date") @db.Date
  traditionalDate String?          @map("traditional_date") @db.VarChar(120)
  verification    DateVerification @default(UNVERIFIED)
  note            String?          @db.VarChar(500)
  verifiedByUserId String?         @map("verified_by_user_id") @db.Uuid
  verifiedAt      DateTime?        @map("verified_at")
  createdAt       DateTime         @default(now()) @map("created_at")

  day CalendarDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@unique([dayId, startDate])
  @@index([startDate, endDate])
  @@map("calendar_dates")
}

/// A community event (festival, gathering, exhibition, online meeting …).
model Event {
  id                 String           @id @default(uuid()) @db.Uuid
  organizerProfileId String           @map("organizer_profile_id") @db.Uuid
  /// Optional organisation name shown as organizer (the account stays responsible).
  hostName           String?          @map("host_name") @db.VarChar(120)
  title              String           @db.VarChar(140)
  summary            String           @db.VarChar(300)
  description        String           @default("") @db.VarChar(8000)
  category           EventCategory
  template           EventTemplate
  audience           EventAudience    @default(PUBLIC)
  status             EventStatus      @default(DRAFT)
  startsAt           DateTime         @map("starts_at")
  endsAt             DateTime         @map("ends_at")
  timeZone           String           @default("UTC") @map("time_zone") @db.VarChar(40)
  country            String?          @db.VarChar(2)
  city               String?          @db.VarChar(80)
  venue              String?          @db.VarChar(200)
  /// false = the venue is shown only to registered participants and the organizer.
  venuePublic        Boolean          @default(true) @map("venue_public")
  onlineUrl          String?          @map("online_url") @db.VarChar(300)
  registration       RegistrationMode @default(NONE)
  registrationUrl    String?          @map("registration_url") @db.VarChar(300)
  capacity           Int?
  contact            String?          @db.VarChar(200)
  /// [{ name, role }]
  speakers           Json?
  /// [{ q, a }]
  faq                Json?
  calendarDayId      String?          @map("calendar_day_id") @db.Uuid
  featuredAt         DateTime?        @map("featured_at")
  reviewNote         String?          @map("review_note") @db.VarChar(500)
  publishedAt        DateTime?        @map("published_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  organizer   Profile          @relation("EventsOrganized", fields: [organizerProfileId], references: [id], onDelete: Cascade)
  calendarDay CalendarDay?     @relation(fields: [calendarDayId], references: [id], onDelete: SetNull)
  sessions    EventSession[]
  attendees   EventAttendee[]
  saves       EventSave[]

  @@index([status, audience, startsAt])
  @@index([organizerProfileId])
  @@index([calendarDayId])
  @@map("events")
}

/// One item of the program / schedule (several stages possible).
model EventSession {
  id        String        @id @default(uuid()) @db.Uuid
  eventId   String        @map("event_id") @db.Uuid
  title     String        @db.VarChar(140)
  startsAt  DateTime      @map("starts_at")
  endsAt    DateTime      @map("ends_at")
  stage     String?       @db.VarChar(80)
  host      String?       @db.VarChar(120)
  kind      String?       @db.VarChar(60)
  status    SessionStatus @default(SCHEDULED)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, startsAt])
  @@map("event_sessions")
}

/// A member registered for an event (RSVP; tickets come later on the same record).
model EventAttendee {
  eventId   String   @map("event_id") @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  profile Profile @relation("EventRegistrations", fields: [profileId], references: [id], onDelete: Cascade)

  @@id([eventId, profileId])
  @@index([profileId])
  @@map("event_attendees")
}

/// "Save for later".
model EventSave {
  eventId   String   @map("event_id") @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  profile Profile @relation("EventSaves", fields: [profileId], references: [id], onDelete: Cascade)

  @@id([eventId, profileId])
  @@index([profileId])
  @@map("event_saves")
}
