# Development defaults — never use these values in production.
DATABASE_URL=postgresql://ftn:ftn_dev@localhost:5432/ftn?schema=public
JWT_SECRET=change-me-dev-only-secret-at-least-32-chars
PORT=4000
CORS_ORIGIN=http://localhost:3000
# Login/register attempts per minute per client (production default 10).
# Raise only for local end-to-end test runs.
AUTH_RATE_LIMIT_PER_MINUTE=10
# Key for encrypting QR tokens at rest (development value — never use in production).
QR_TOKEN_KEY=change-me-dev-only-qr-key-at-least-32-chars
